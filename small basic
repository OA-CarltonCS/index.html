HTML
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Learn Small Basic - KS3 Interactive Guide</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&family=Lato:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        :root {
            --primary: #002D5B;
            --secondary: #00A8A8;
            --accent: #FFB800;
            --dark: #2C3E50;
            --light: #F8F9FA;
            --success: #28A745;
            --danger: #DC3545;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Lato', sans-serif;
            background-color: #F0F2F5;
            color: var(--dark);
            line-height: 1.6;
        }

        header {
            background: linear-gradient(135deg, var(--primary) 0%, #001A35 100%);
            color: white;
            padding: 60px 20px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        header h1 {
            font-family: 'Poppins', sans-serif;
            font-size: 3rem;
            margin-bottom: 10px;
        }

        header p {
            font-size: 1.2rem;
            opacity: 0.9;
        }

        .container {
            max-width: 1100px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .card {
            background: white;
            border-radius: 12px;
            padding: 35px;
            margin-bottom: 30px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            border-left: 6px solid var(--secondary);
        }

        h2 {
            font-family: 'Poppins', sans-serif;
            color: var(--primary);
            font-size: 1.8rem;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        h3 {
            font-family: 'Poppins', sans-serif;
            color: var(--secondary);
            margin: 20px 0 10px 0;
        }

        p {
            font-size: 1.1rem;
            margin-bottom: 15px;
            color: #555;
        }

        /* Code Blocks */
        .code-window {
            background: #1E1E1E;
            color: #D4D4D4;
            padding: 20px;
            border-radius: 8px;
            font-family: 'Courier New', Courier, monospace;
            font-size: 1.1rem;
            margin: 15px 0;
            position: relative;
            box-shadow: inset 0 0 10px rgba(0,0,0,0.5);
        }

        .code-window::before {
            content: "Small Basic Code";
            position: absolute;
            top: 2px;
            right: 10px;
            font-size: 0.75rem;
            color: #666;
            font-family: 'Lato', sans-serif;
        }

        .keyword { color: #569CD6; font-weight: bold; }
        .string { color: #CE9178; }
        .comment { color: #6A9955; font-style: italic; }
        .object { color: #4EC9B0; }

        /* Explanation Grid */
        .explainer-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-top: 15px;
        }

        @media (max-width: 768px) {
            .explainer-grid { grid-template-columns: 1fr; }
        }

        .explain-box {
            background: #EDF7F7;
            padding: 15px;
            border-radius: 8px;
            border-left: 4px solid var(--secondary);
        }

        /* Glossary Table */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
            background: white;
        }

        th {
            background-color: var(--primary);
            color: white;
            text-align: left;
            padding: 12px;
            font-family: 'Poppins', sans-serif;
        }

        td {
            padding: 12px;
            border-bottom: 1px solid #E0E0E0;
        }

        tr:nth-child(even) { background-color: #F9F9F9; }

        /* QUIZ ARCHITECTURE */
        .quiz-section {
            background: #FFF;
            border-left: 6px solid var(--accent);
        }

        .quiz-container {
            background: #F9FAFB;
            padding: 25px;
            border-radius: 8px;
            margin-bottom: 25px;
            border: 1px solid #E5E7EB;
        }

        .quiz-question {
            font-size: 1.2rem;
            font-weight: bold;
            margin-bottom: 15px;
            color: var(--primary);
        }

        .option-btn {
            display: block;
            width: 100%;
            text-align: left;
            padding: 14px 20px;
            margin-bottom: 10px;
            background: white;
            border: 2px solid #E5E7EB;
            border-radius: 8px;
            cursor: pointer;
            font-size: 1rem;
            transition: all 0.2s ease;
        }

        .option-btn:hover {
            border-color: var(--secondary);
            background-color: #F0F9F9;
        }

        /* Drag and Drop Styles */
        .drag-container {
            display: flex;
            gap: 15px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .drag-item {
            padding: 10px 20px;
            background: var(--primary);
            color: white;
            border-radius: 6px;
            cursor: grab;
            font-weight: bold;
            user-select: none;
        }

        .drop-target-wrapper {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: white;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 10px;
            border: 1px solid #E5E7EB;
        }

        .drop-zone {
            width: 200px;
            height: 45px;
            background: #E5E7EB;
            border: 2px dashed #9CA3AF;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            transition: background 0.2s;
        }

        .drop-zone.hovered {
            background: #D1FAE5;
            border-color: var(--success);
        }

        .drop-zone .drag-item {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: default;
        }

        /* Dropdown cloze style */
        .cloze-sentence {
            font-size: 1.2rem;
            line-height: 2;
            background: white;
            padding: 20px;
            border-radius: 8px;
            border: 1px solid #E5E7EB;
        }

        select {
            padding: 6px 10px;
            font-size: 1rem;
            border: 2px solid var(--secondary);
            border-radius: 6px;
            background: white;
            font-weight: bold;
            color: var(--primary);
            cursor: pointer;
        }

        /* Action Buttons */
        .action-btn {
            background: var(--primary);
            color: white;
            border: none;
            padding: 12px 25px;
            font-size: 1rem;
            font-weight: bold;
            border-radius: 6px;
            cursor: pointer;
            margin-top: 15px;
            transition: background 0.2s;
        }

        .action-btn:hover { background: #001F40; }

        .feedback {
            margin-top: 15px;
            padding: 12px;
            border-radius: 6px;
            font-weight: bold;
            display: none;
        }

        .feedback.correct {
            display: block;
            background: #D1FAE5;
            color: #065F46;
            border: 1px solid #10B981;
        }

        .feedback.wrong {
            display: block;
            background: #FEE2E2;
            color: #991B1B;
            border: 1px solid #EF4444;
        }
    </style>
</head>
<body>

    <header>
        <h1>Mastering Small Basic</h1>
        <p>Your Interactive Guide to Text Coding & Turtle Graphics (Key Stage 3)</p>
    </header>

    <div class="container">

        <div class="card">
            <h2><i class="fa-solid fa-turtle"></i> 1. Commanding the Turtle</h2>
            <p>In Small Basic, we can direct a virtual <strong>Turtle</strong> to draw shapes and lines on a graphics canvas. Imagine it as a tiny robot holding down a felt-tip pen while it explores your screen.</p>
            
            <div class="code-window">
                <span class="object">Turtle</span>.Speed = <span class="string">7</span><br>
                <span class="object">Turtle</span>.Move(<span class="string">100</span>)<br>
                <span class="object">Turtle</span>.Turn(<span class="string">90</span>)
            </div>

            <div class="explainer-grid">
                <div class="explain-box">
                    <h3><i class="fa-solid fa-gauge-high"></i> Turtle.Speed</h3>
                    <p>Sets how fast your Turtle travels. Choose a number from <strong>1 (slowest) to 10 (fastest)</strong>.</p>
                </div>
                <div class="explain-box">
                    <h3><i class="fa-solid fa-compass"></i> Move() and Turn()</h3>
                    <p><code>Move(100)</code> pushes the turtle forward by 100 steps (pixels). <code>Turn(90)</code> rotates the turtle 90 degrees to its right.</p>
                </div>
            </div>
        </div>

        <div class="card">
            <h2><i class="fa-solid fa-arrows-spin"></i> 2. Loops (Iteration)</h2>
            <p>Why write the same line of code four times when you can tell the computer to repeat it? A <strong>For Loop</strong> repeats commands efficiently.</p>

            <div class="code-window">
                <span class="keyword">For</span> i = <span class="string">1</span> <span class="keyword">To</span> <span class="string">4</span><br>
                &nbsp;&nbsp;<span class="object">Turtle</span>.Move(<span class="string">100</span>)<br>
                &nbsp;&nbsp;<span class="object">Turtle</span>.Turn(<span class="string">90</span>)<br>
                <span class="keyword">EndFor</span>
            </div>

            <p><i class="fa-solid fa-lightbulb" style="color: var(--accent)"></i> <strong>Code Breakdown:</strong> The counter variable <code>i</code> starts at 1. The computer runs the code inside, hits <code>EndFor</code>, goes back up, and sets <code>i</code> to 2. This continues until it hits 4, successfully drawing a perfect square with minimal code!</p>
        </div>

        <div class="card">
            <h2><i class="fa-solid fa-book"></i> 3. Key Vocabulary Glossary</h2>
            <p>Make sure you understand these core words before diving into your assessment challenge:</p>
            
            <table>
                <thead>
                    <tr>
                        <th>Keyword / Object</th>
                        <th>What It Means</th>
                        <th>Example Usage</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><strong>Variable</strong></td>
                        <td>A named container used to store values or information.</td>
                        <td><code>score = 10</code></td>
                    </tr>
                    <tr>
                        <td><strong>TextWindow</strong></td>
                        <td>The text-only screen console used to read entries or write sentences.</td>
                        <td><code>TextWindow.Read()</code></td>
                    </tr>
                    <tr>
                        <td><strong>Selection</strong></td>
                        <td>Making decisions in code based on conditions using If/Else.</td>
                        <td><code>If age >= 12 Then</code></td>
                    </tr>
                    <tr>
                        <td><strong>ForegroundColor</strong></td>
                        <td>Changes the visual color of text printed to the window.</td>
                        <td><code>TextWindow.ForegroundColor = "Cyan"</code></td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="card quiz-section">
            <h2><i class="fa-solid fa-graduation-cap"></i> Interactive Knowledge Challenge</h2>
            <p>Prove your skills! These tasks start off easy and become increasingly advanced.</p>

            <hr style="margin: 20px 0; border: 0; border-top: 1px solid #E5E7EB;">

            <div class="quiz-container" id="q1-block">
                <div class="quiz-question">Task 1 (Easy): Which command hides the line behind the turtle while it travels?</div>
                <button class="option-btn" onclick="checkQ1(this, false)">Turtle.Stop()</button>
                <button class="option-btn" onclick="checkQ1(this, true)">Turtle.PenUp()</button>
                <button class="option-btn" onclick="checkQ1(this, false)">Turtle.PenDown()</button>
                <button class="option-btn" onclick="checkQ1(this, false)">Turtle.Hide()</button>
                <div id="q1-feedback" class="feedback"></div>
            </div>

            <div class="quiz-container">
                <div class="quiz-question">Task 2 (Medium): Match the Small Basic elements to their correct definition!</div>
                <p style="font-size: 0.95rem; color:#666;">Drag the blue code boxes onto the correct light grey target zones.</p>
                
                <div class="drag-container">
                    <div class="drag-item" draggable="true" id="drag1">TextWindow.Read()</div>
                    <div class="drag-item" draggable="true" id="drag2">EndFor</div>
                    <div class="drag-item" draggable="true" id="drag3">WriteLine()</div>
                </div>

                <div class="drop-target-wrapper">
                    <span>Prints text on screen and goes to a new line:</span>
                    <div class="drop-zone" id="zone-WriteLine()" data-expected="drag3">Drop here</div>
                </div>
                <div class="drop-target-wrapper">
                    <span>Pauses the program to let the user type in data:</span>
                    <div class="drop-zone" id="zone-Read()" data-expected="drag1">Drop here</div>
                </div>
                <div class="drop-target-wrapper">
                    <span>Tells the program where a repeating loop closes:</span>
                    <div class="drop-zone" id="zone-EndFor()" data-expected="drag2">Drop here</div>
                </div>

                <button class="action-btn" onclick="checkDragDrop()">Validate Matchings</button>
                <div id="drag-feedback" class="feedback"></div>
            </div>

            <div class="quiz-container">
                <div class="quiz-question">Task 3 (Superstar Level): Complete the Selection Statement Logic</div>
                
                <div class="cloze-sentence">
                    "When building branching paths, we initiate the logic block using an 
                    <select id="cloze1">
                        <option value="">-- Choose --</option>
                        <option value="wrong">For</option>
                        <option value="correct">If</option>
                        <option value="wrong">While</option>
                    </select>
                    statement. If our initial check fails, but we want to inspect an alternative scenario, we append an 
                    <select id="cloze2">
                        <option value="">-- Choose --</option>
                        <option value="correct">ElseIf</option>
                        <option value="wrong">Else</option>
                        <option value="wrong">Then</option>
                    </select>. 
                    Should none of our defined conditions match, the fallback option triggers under an 
                    <select id="cloze3">
                        <option value="">-- Choose --</option>
                        <option value="wrong">EndIf</option>
                        <option value="correct">Else</option>
                        <option value="wrong">Loop</option>
                    </select> 
                    block. Finally, we must seal off our selection segment using the keyword 
                    <select id="cloze4">
                        <option value="">-- Choose --</option>
                        <option value="wrong">Next</option>
                        <option value="correct">EndIf</option>
                        <option value="wrong">Stop</option>
                    </select>."
                </div>

                <button class="action-btn" onclick="checkCloze()">Submit Paragraph</button>
                <div id="cloze-feedback" class="feedback"></div>
            </div>

        </div>

    </div>

    <script>
        // --- Task 1: Multiple Choice Logic ---
        function checkQ1(buttonElement, isCorrect) {
            const feedback = document.getElementById('q1-feedback');
            const options = document.querySelectorAll('#q1-block .option-btn');
            
            // Disable all options once an answer is selected
            options.forEach(btn => btn.style.pointerEvents = 'none');

            if(isCorrect) {
                buttonElement.style.background = "#D1FAE5";
                buttonElement.style.borderColor = "var(--success)";
                feedback.className = "feedback correct";
                feedback.innerText = "Correct! Turtle.PenUp() lifts the drawing pen up.";
            } else {
                buttonElement.style.background = "#FEE2E2";
                buttonElement.style.borderColor = "var(--danger)";
                feedback.className = "feedback wrong";
                feedback.innerText = "Incorrect. Try refreshing the page to attempt again!";
            }
        }

        // --- Task 2: Drag and Drop Implementation ---
        const dragItems = document.querySelectorAll('.drag-item');
        const dropZones = document.querySelectorAll('.drop-zone');

        dragItems.forEach(item => {
            item.addEventListener('dragstart', (e) => {
                e.dataTransfer.setData('text/plain', e.target.id);
            });
        });

        dropZones.forEach(zone => {
            zone.addEventListener('dragover', (e) => {
                e.preventDefault();
                zone.classList.add('hovered');
            });

            zone.addEventListener('dragleave', () => {
                zone.classList.remove('hovered');
            });

            zone.addEventListener('drop', (e) => {
                e.preventDefault();
                zone.classList.remove('hovered');
                const id = e.dataTransfer.getData('text/plain');
                const draggedElement = document.getElementById(id);
                
                // If zone already contains an element, don't drop
                if(zone.children.length === 0) {
                    zone.innerText = "";
                    zone.appendChild(draggedElement);
                }
            });
        });

        function checkDragDrop() {
            let score = 0;
            const zones = document.querySelectorAll('.drop-zone');
            const feedback = document.getElementById('drag-feedback');

            zones.forEach(zone => {
                if(zone.firstElementChild && zone.firstElementChild.id === zone.getAttribute('data-expected')) {
                    score++;
                }
            });

            if(score === 3) {
                feedback.className = "feedback correct";
                feedback.innerText = "Great job! All definitions are correctly matched.";
            } else {
                feedback.className = "feedback wrong";
                feedback.innerText = `You matched ${score}/3 correctly. Drag boxes back or reload to re-try.`;
            }
        }

        // --- Task 3: Cloze Paragraph Dropdowns ---
        function checkCloze() {
            const c1 = document.getElementById('cloze1').value;
            const c2 = document.getElementById('cloze2').value;
            const c3 = document.getElementById('cloze3').value;
            const c4 = document.getElementById('cloze4').value;
            const feedback = document.getElementById('cloze-feedback');

            if(c1 === 'correct' && c2 === 'correct' && c3 === 'correct' && c4 === 'correct') {
                feedback.className = "feedback correct";
                feedback.innerText = "Perfect! You completely master selection architecture logic.";
            } else {
                feedback.className = "feedback wrong";
                feedback.innerText = "Some dropdown values are incorrect. Review your selection statements and try again.";
            }
        }
    </script>
</body>
</html>
